#!/bin/sh
# Runs before every commit: ./build.sh (the game script must parse) and a scan
# of the staged files for bidi control characters.
# Enable with: git config core.hooksPath githooks
#
# build.sh checks the working tree, so unstaged edits count; CI checks exactly
# what was pushed.
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

./build.sh || { echo "pre-commit: build.sh failed: the game script doesn't parse" >&2; exit 1; }

# U+202A-U+202E and U+2066-U+2069 can make code read differently from how it
# runs. git grep exits 0 on a match, 1 on none, and anything else on an error,
# which must not pass as clean.
status=0
git grep --cached -lP '[\x{202A}-\x{202E}\x{2066}-\x{2069}]' || status=$?
case "$status" in
  0) echo "pre-commit: the staged files above contain bidi control characters" >&2; exit 1 ;;
  1) ;;
  *) echo "pre-commit: the bidi scan could not run (git grep exit $status)" >&2; exit 1 ;;
esac

echo "pre-commit: build and bidi scan passed"
